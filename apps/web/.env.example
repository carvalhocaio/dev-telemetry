# Database (PostgreSQL / Neon)
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Better Auth
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=your_32_plus_char_random_secret_here

# GitHub OAuth App (for web sign-in)
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret

# Encryption key for stored PATs and LLM keys (64 hex characters = 32 bytes)
# Generate with: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
SECRET_ENCRYPTION_KEY=your_64_character_hex_encryption_key_here

# Optional: LLM API keys (can also be entered in /settings)
GOOGLE_GENERATIVE_AI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
